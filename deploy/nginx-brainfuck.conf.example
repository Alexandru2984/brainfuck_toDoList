server {
    listen 80;
    listen [::]:80;
    server_name brainfuck.micutu.com;

    access_log /var/log/nginx/brainfuck-canary.access.log;
    error_log /var/log/nginx/brainfuck-canary.error.log warn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name brainfuck.micutu.com;

    access_log /var/log/nginx/brainfuck-canary.access.log;
    error_log /var/log/nginx/brainfuck-canary.error.log warn;
    server_tokens off;
    client_max_body_size 16k;
    limit_req_status 429;

    # The app also secures direct loopback responses. Emit one consistent set
    # at the edge instead of duplicate (and potentially ambiguous) headers.
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Cross-Origin-Opener-Policy;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Strict-Transport-Security;

    # Only Cloudflare and the locally terminated Cloudflare Tunnel reach this vhost.
    set $brainfuck_origin_allowed $from_cloudflare_origin;
    if ($brainfuck_origin_allowed = 0) {
        return 403;
    }

    ssl_certificate /etc/letsencrypt/live/brainfuck.micutu.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brainfuck.micutu.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:brainfuck_canary_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    location = /login {
        limit_req zone=brainfuck_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:34623;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(add|edit/[0-9]+|toggle/[0-9]+|delete/[0-9]+|move/[0-9]+|duplicate/[0-9]+|clear-completed|reorder|logout)$ {
        limit_req zone=brainfuck_mutation burst=10 nodelay;
        proxy_pass http://127.0.0.1:34623;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    location / {
        proxy_pass http://127.0.0.1:34623;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;
}
