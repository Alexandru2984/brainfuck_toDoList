# The limit_req_zone directives must live in nginx's http context.
limit_req_zone $binary_remote_addr zone=brainfuck_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=brainfuck_mutation:10m rate=30r/m;

server {
    include snippets/block-dotfiles.conf;
    server_name brainfuck.micutu.com;
    listen 443 ssl;

    if ($from_cloudflare_origin = 0) {
        return 403;
    }

    client_max_body_size 16k;

    location = /login {
        limit_req zone=brainfuck_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:34623;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(add|delete/|logout) {
        limit_req zone=brainfuck_mutation burst=10 nodelay;
        proxy_pass http://127.0.0.1:34623;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:34623;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://analytics.micutu.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://analytics.micutu.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;

    include snippets/robots.conf;
    ssl_certificate /etc/letsencrypt/live/brainfuck.micutu.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brainfuck.micutu.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    include snippets/block-dotfiles.conf;
    server_name brainfuck.micutu.com;
    listen 80;
    return 301 https://$host$request_uri;
}
