# Copy to /etc/brainfuck/brainfuck.env and chmod 600.
# Never commit the real file.
BRAINFUCK_SECRET_KEY=replace-with-random-token
BRAINFUCK_PASSWORD=replace-with-private-password
BRAINFUCK_MAX_TASK_LENGTH=500
BRAINFUCK_MAX_CONTENT_LENGTH=16384
BRAINFUCK_MAX_BF_STEPS=1000000
BRAINFUCK_MAX_BF_OUTPUT=50000
BRAINFUCK_SQLITE_TIMEOUT_SECONDS=5
BRAINFUCK_SESSION_LIFETIME_SECONDS=43200
BRAINFUCK_COOKIE_SECURE=1
BRAINFUCK_COOKIE_SAMESITE=Lax
BRAINFUCK_SECURITY_HEADERS_ENABLED=0
# Behind Cloudflare -> Nginx -> Gunicorn. Trust proxy headers for the real
# client IP (used for login throttling and logs). CF-Connecting-IP is set by
# Cloudflare; keep TRUST_PROXY=1 only while the origin is locked to Cloudflare.
BRAINFUCK_TRUST_PROXY=1
BRAINFUCK_PROXY_HOPS=1
BRAINFUCK_TRUSTED_IP_HEADER=CF-Connecting-IP
# App-level brute-force throttle: lock an IP after N failed logins per window.
BRAINFUCK_LOGIN_MAX_ATTEMPTS=8
BRAINFUCK_LOGIN_WINDOW_SECONDS=300
