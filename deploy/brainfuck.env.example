# Copy to /etc/brainfuck/brainfuck.env and chmod 600.
# Never commit the real file.
BRAINFUCK_SECRET_KEY=replace-with-random-token
BRAINFUCK_PASSWORD=replace-with-private-password
BRAINFUCK_MAX_TASK_LENGTH=500
BRAINFUCK_MAX_CONTENT_LENGTH=16384
BRAINFUCK_MAX_BF_STEPS=1000000
BRAINFUCK_MAX_BF_OUTPUT=50000
BRAINFUCK_COOKIE_SECURE=1
BRAINFUCK_COOKIE_SAMESITE=Lax
